
<style>
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border: none;
    margin: 0.1 rem;
    border-radius: 25px;

    display: flex;
    align-items: center;
    white-space: nowrap;
    margin-left: 1 rem;
  }

  .btn-search:hover {
    background-color: #fe424d;
  }

  .btn-search i {
    display: inline;
  }
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top <% if(typeof homePage !== 'undefined' && homePage){ %>home-navbar<% } else { %>bg-body-light<% } %>">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        
        <a class="nav-link" href="/listings">Explore</a>
        
      </div>

      <div class="navbar-nav ms-auto">
        <form class="form-inline d-flex" method="GET" action="/listings">

    <input
        class="form-control me-2"
        type="search"
        name="search"
        placeholder="Search Destination"
        aria-label="Search"
        value="<%= typeof search !== 'undefined' ? search : '' %>"
    >

    <% if(typeof selectedCategory !== 'undefined' && selectedCategory){ %>
        <input
            type="hidden"
            name="category"
            value="<%= selectedCategory %>"
        >
    <% } %>

    <button class="btn-search" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
        Search
    </button>

</form>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add New Listing</a>
        <% if(!currUser) { %>
        <a class="nav-link" aria-current="page" href="/signup"> <b>Sign up</b></a>
        <a class="nav-link" href="/login"> <b>Login</b> </a>
        <% } %>

        <% if(currUser){ %>
        <a class="nav-link" href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>